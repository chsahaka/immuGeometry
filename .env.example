# GEMINI_API_KEY: Required for Gemini AI API calls.
# This variable should be configured with your API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_CF_WORKER_URL: Your deployed Cloudflare Worker URL
# Set this to your worker url for GitHub Pages deployment (e.g. "https://immu-gemini-proxy.username.workers.dev")
# If left empty, the local backend will proxy the requests via Express
VITE_CF_WORKER_URL=""
